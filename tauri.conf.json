{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArgonStream",
  "identifier": "com.khryz.ytdownloader",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/ffmpeg"],
    "resources": { "binaries/ffmpeg.LICENSE": "ffmpeg.LICENSE" },
    "windows": { "nsis": { "template": "installer/installer.nsi" } }
  }
}
